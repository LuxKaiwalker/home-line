# Environment for server/ops/compose.yaml (WS12 O1). Names only; every one is optional and has a
# default in compose.yaml. No secrets: the D69 local stack needs none (no Supabase, no team token).
# Copy to server/ops/.env (git-ignored) or export in the shell. server/ops/up.sh sets the first two.
HL_COMMIT=
HL_ENGINE_TREE=
HL_SERVER_DATA=
HL_PROXY_PORT=
HL_API_PORT=
HL_PROXY_MAX_BODY=
HL_HEAVY_JOBS_OFF=
