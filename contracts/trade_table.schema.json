{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homeline/contracts/trade_table.schema.json",
  "title": "trade_table.json",
  "description": "Trade table (F11): rows = walkback budgets (min), cols = suit masses (kg), cells[row][col].",
  "x-contract-version": "1.0.0",
  "x-source": "SPEC §6",
  "type": "object",
  "properties": {
    "dummy": {
      "type": "boolean",
      "description": "optional; true only in data-dummy/"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "description": "walkback budget, min"
    },
    "cols": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "description": "suit mass, kg"
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "science_value": {
              "type": [
                "number",
                "null"
              ]
            },
            "reachable_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "partner_area_km2": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "science_value",
            "reachable_pct",
            "partner_area_km2"
          ]
        }
      }
    }
  },
  "required": [
    "rows",
    "cols",
    "cells"
  ]
}
